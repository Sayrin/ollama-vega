diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 790553888..10c89c47d 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -4970,6 +4970,49 @@ static bool ggml_backend_cuda_get_available_uma_memory(long * available_memory_k
 static void ggml_backend_cuda_device_get_memory(ggml_backend_dev_t dev, size_t * free, size_t * total) {
     ggml_backend_cuda_device_context * ctx = (ggml_backend_cuda_device_context *)dev->context;
     ggml_cuda_set_device(ctx->device);
+
+#if defined(GGML_USE_HIP) && defined(__linux__)
+    // hipMemGetInfo() is unreliable on this older Vega/ROCm combination.
+    // Use HIP for total VRAM and Linux DRM sysfs for used VRAM.
+    cudaDeviceProp prop;
+    CUDA_CHECK(cudaGetDeviceProperties(&prop, ggml_cuda_get_physical_device(ctx->device)));
+
+    *total = prop.totalGlobalMem;
+    *free = 0;
+
+    const int physical_device = ggml_cuda_get_physical_device(ctx->device);
+
+    char path[256];
+    snprintf(path, sizeof(path),
+             "/sys/class/drm/card%d/device/mem_info_vram_used",
+             physical_device);
+
+    FILE * f = fopen(path, "r");
+
+    if (f != nullptr) {
+        unsigned long long used = 0;
+
+        if (fscanf(f, "%llu", &used) == 1) {
+            if (used < *total) {
+                *free = *total - (size_t) used;
+            }
+        }
+
+        fclose(f);
+    }
+
+    GGML_LOG_DEBUG("%s: HIP VRAM device %d: free=%zu MiB total=%zu MiB\n",
+                   __func__,
+                   physical_device,
+                   *free / (1024 * 1024),
+                   *total / (1024 * 1024));
+
+    if (*free == 0) {
+        GGML_LOG_WARN("%s: failed to read VRAM usage from %s\n",
+                      __func__, path);
+    }
+
+#else
     cudaError_t err = cudaMemGetInfo(free, total);
     if (err != cudaSuccess) {
         (void)cudaGetLastError();
@@ -4978,6 +5021,7 @@ static void ggml_backend_cuda_device_get_memory(ggml_backend_dev_t dev, size_t *
         *total = 0;
         return;
     }
+#endif

 // ref: https://github.com/ggml-org/llama.cpp/pull/17368
 #if defined(__linux__) && !defined(GGML_USE_HIP)
